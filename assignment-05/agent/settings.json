{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 .claude/hooks/entry_gate.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 .claude/hooks/exit_gate.py"
          }
        ]
      }
    ]
  }
}
